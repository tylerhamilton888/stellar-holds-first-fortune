extends "res://tests/support/game_fixture.gd"
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 g.state.opening=4;HoldOnboarding.ensure(g.state).fresh=false;g.state.claim_id="old_delving";g.surface.enter("claim");settle()
 g.state.add("wood",100);g.state.add("stone",100)
 var s=g.surface;g.player=Vector2(940,650)
 check(s.snap_furnishing(Vector2(933,618))==Vector2(930,620),"Fine furnishing grid aligns preview and committed placement")
 s.start_placement("tea_table");var stock=g.state.count("wood")
 check(s.place(Vector2(940,600)),"Furnished tea table is crafted and placed")
 check(g.state.count("wood")==stock-4,"Table consumes its recipe exactly once")
 check(HoldFurnishings.footprint("tea_table",Vector2.ZERO)==HoldFurnishings.footprint("table",Vector2.ZERO),"Tabletop dressing shares the table's physical geometry")
 check(not s.walkable(Vector2(940,585)) and s.walkable(Vector2(940,625)),"Painted table base blocks feet while its front approach remains open")
 check(s.move_nearby_furnishing(),"Placed table can be selected for repositioning")
 var table=g.state.surface.decor.back();var old=Vector2(table.x,table.y);stock=g.state.count("wood")
 check(s.place(Vector2(990,600)),"Table moves to valid nearby ground")
 check(g.state.count("wood")==stock and g.state.surface.decor.size()==1,"Moving neither charges nor duplicates furniture")
 check(s.walkable(old-Vector2(0,15)) and not s.walkable(Vector2(990,585)),"Collision follows the moved table")
 g.player=Vector2(990,650);s.move_nearby_furnishing();s.cancel_placement()
 check(Vector2(table.x,table.y)==Vector2(990,600),"Cancel leaves the original placement intact")
 s.start_placement("chest");g.player=Vector2(860,700)
 check(s.place(Vector2(850,650)),"Player crafts a movable storage chest")
 var id="chest:"+str(int(g.state.surface.next_chest)-1);var chest=g.state.surface.chests[id];chest.items={"stone":17}
 check(s.move_nearby_furnishing(),"Filled player chest can be selected")
 stock=g.state.count("wood")
 check(s.place(Vector2(890,650)),"Filled chest can be repositioned on the fine grid")
 check(g.state.surface.chests[id].items.stone==17 and g.state.count("wood")==stock,"Repositioning preserves chest identity, contents and materials")
 s.start_placement("chest")
 check(s.place(Vector2(830,650)),"Storage chests can form a close row while keeping front access")
 s.start_placement("lamp")
 check(not s.place(Vector2(990,600)),"Overlapping painted bases cannot be built")
 s.cancel_placement();g.camera=s.camera_target();await snap("worksite")
 g.player=Vector2(940,700);g.camera=s.camera_target();s.start_placement("tea_table")
 var target=Vector2.ZERO
 for x in range(800,1081,10):
  for y in range(580,831,10):
   var candidate=Vector2(x,y)
   if s.furniture_ready(candidate,"tea_table"):target=candidate
 
 check(s.furniture_ready(target,"tea_table"),"Clear affordable placement previews green")
 root.warp_mouse(target-g.camera);await snap("grid-green")
 check(not s.furniture_ready(Vector2(990,600),"tea_table"),"Occupied footprint previews red")
 root.warp_mouse(Vector2(990,600)-g.camera);await snap("grid-red")
 var resources=g.state.inventory.duplicate(true)
 g.state.inventory.clear()
 check(not s.furniture_ready(target,"tea_table"),"Missing materials preview red even on clear ground")
 g.state.inventory=resources
 s.cancel_placement()
 g.player=Vector2(920,500);g.camera=s.camera_target()
 var h=s.house;var cell=Vector2i(23,11)
 check(h.ready_to_build(cell,"stone_floor"),"Affordable foundation previews green")
 s.placing="house:stone_floor";root.warp_mouse(h.center(cell)-g.camera);await snap("grid-foundation")
 check(h.build(h.center(cell),"stone_floor"),"Green foundation can actually be built")
 check(not h.ready_to_build(cell,"stone_floor"),"Duplicate foundation previews red")
 check(h.build(h.center(cell),"stairs"),"Clear foundation accepts connected stairs")
 check(not h.ready_to_build(cell,"wall"),"Stair landing cannot preview a blocking wall as valid")
 s.cancel_placement()
 var decor=g.state.surface.decor.duplicate(true);g.save_game();g.start_game(true);settle()
 check(g.state.surface.decor==JSON.parse_string(JSON.stringify(decor)) and g.state.surface.chests[id].items.stone==17,"Decor positions and chest contents survive save/reload")
 g.surface.enter("room:tavern");settle();await snap("tavern")
 check(g.surface.world.room_objects().any(func(o):return o.get("furnishing","")=="tea_table"),"Town tables use the same furnished variant as player construction")
 g.surface.enter("room:home");settle();g.player=Vector2(784,500)
 Input.action_press("right");Input.action_press("up");g.surface.move(.1);Input.action_release("right");Input.action_release("up")
 check(g.walking_pose and g.surface.direction.y<-.9 and absf(g.surface.direction.x)<.01,"Wall sliding faces the actual travel direction")
 var gait=g.gait_clock
 Input.action_press("right");g.surface.move(.1);Input.action_release("right")
 check(not g.walking_pose and g.gait_clock==gait,"Blocked movement stops the walking gait")
 print("MODULAR64: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.queue_free();await process_frame;quit(1 if failed else 0)
