extends "res://tests/support/game_fixture.gd"
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 g.state.opening=4;HoldOnboarding.ensure(g.state).fresh=false;HoldOnboarding.ensure(g.state).combat=true
 g.handworks.data().skills={"miner":40,"mason":16,"forester":12,"smith":4};g.state.hauling.erase("disciplines")
 check(HoldDisciplines.xp(g.state,"mining")==40 and HoldDisciplines.xp(g.state,"woodworking")==12,"Legacy work is migrated once without losing earned hauling")
 check(g.handworks.capacity()==2,"Existing strong shoulders remain unlocked")
 check(not HoldDisciplines.learn(g.state,"ore_sorting"),"Work alone cannot bypass research")
 g.state.tech.extraction=true
 check(HoldDisciplines.learn(g.state,"ore_sorting"),"Relevant work and knowledge unlock selective recovery")
 check(not HoldDisciplines.learn(g.state,"ore_sorting") and HoldDisciplines.xp(g.state,"mining")==40,"Learning is idempotent and does not consume experience")
 var count=g.handworks.data().loose.size()
 g.handworks.rock({"kind":3,"item":"iron_ore","count":2},Vector2i(20,20))
 check(g.handworks.data().loose.size()==count+1 and g.handworks.data().loose.back().units==3,"Mining technique changes physical ore yield")
 HoldDisciplines.award(g.state,"overseer",1,"test");HoldDisciplines.award(g.state,"overseer",1,"test")
 check(HoldDisciplines.xp(g.state,"overseer")==1,"Unique deeds cannot be repeated for XP")
 check(not HoldDisciplines.learn(g.state,"unknown"),"Unknown save or UI technique cannot be learned")
 for path in HoldDisciplines.PATHS:
  g.skill_detail=true;g.discipline_tab=path;g.open_panel("disciplines");await frames(2)
  check(g.panel.get_global_rect().end.y<=g.get_viewport_rect().size.y,"Panel fits viewport: "+path)
  if path in ["mining","engineer","brewing"]:await snap("path-"+path)
 var before=HoldDisciplines.xp(g.state,"smithing")
 g.state.add("iron_ore",2);g.state.add("coal",1);check(g.state.craft("iron"),"Existing forge accepts metal production")
 g.state.tick(20)
 check(HoldDisciplines.xp(g.state,"smithing")==before+1,"Only completed production awards smithing experience")
 HoldDisciplines.award(g.state,"engineer",24);g.state.tech.metallurgy=true;g.state.tech.automation=true
 check(not HoldDisciplines.learn(g.state,"fitted_drives"),"Branch prerequisite enforced")
 check(HoldDisciplines.learn(g.state,"load_bracing") and HoldDisciplines.learn(g.state,"fitted_drives"),"Branch advances through prerequisites")
 check(g.handworks.load_capacity({"kind":"cart"})==int(g.handworks.SPECS.cart.capacity)+8,"Engineering and legacy cart capacity stack")
 check(is_equal_approx(HoldDisciplines.recipe_speed(g.state,"parts"),1.2),"Engineering technique affects only relevant production")
 var saved=HoldDisciplines.data(g.state).duplicate(true);g.save_game();g.start_game(true);settle()
 var restored=HoldDisciplines.data(g.state)
 var same=restored.learned==saved.learned and restored.events==saved.events
 for path in saved.xp:same=same and HoldDisciplines.xp(g.state,path)==int(saved.xp[path])
 check(same,"Progression survives actual save and reload")
 g.close_panel();key(KEY_Y);check(g.panel_id=="disciplines" and g.menu_paused,"Y opens a safely paused development screen")
 g.close_panel();g.skill_detail=true;g.discipline_tab="farming";HoldDisciplines.award(g.state,"farming",16);g.open_panel("disciplines");button("Learn technique")
 check(HoldDisciplines.has(g.state,"gentle_tending"),"Actual Learn button commits the earlier farming technique")
 button("Learn technique")
 check(HoldDisciplines.has(g.state,"seed_selection"),"Actual Learn button still commits Seed selection after learning Gentle tending")
 g.close_panel();g.surface.enter("trail");g.surface.action("mine");settle();key(KEY_Y)
 check(g.panel_id=="disciplines","Development shortcut works underground without replacing unload or crew controls")
 g.close_panel()
 HoldDisciplines.award(g.state,"warrior",6);check(HoldDisciplines.learn(g.state,"sure_footing"),"Combat mastery unlocks recovery technique")
 g.combat.dodge_cooldown=0;g.combat.attack_left=0;g.combat.dodge()
 check(is_equal_approx(g.combat.dodge_cooldown,.58),"Learned footwork changes actual dodge recovery")
 g.state.camp_stage=1;HoldDisciplines.award(g.state,"overseer",1)
 check(HoldDisciplines.learn(g.state,"crew_planning") and HoldOutpost.capacity(g.state)==3,"Crew planning expands an actual camp without conferring a title")
 check(HoldDisciplines.learn(g.state,"timber_selection" )==false,"Insufficient forestry work stays locked")
 HoldDisciplines.award(g.state,"forestry",4);HoldDisciplines.learn(g.state,"timber_selection");g.handworks.spawn("log",g.player,2,"quality-test")
 check(g.handworks.data().loose.back().units==3,"Forestry mastery changes new physical logs")
 g.state.tech.thermal=true;HoldDisciplines.award(g.state,"runecarving",8);HoldDisciplines.learn(g.state,"rune_economy")
 g.state.add("crystal",1);g.state.add("copper",1);g.state.add("coal",2);var cells=g.state.count("energy_cell")
 g.state.craft("energy_cell");g.state.tick(20)
 check(g.state.count("energy_cell")==cells+4,"Runecarving produces additional usable cells at completion")
 print("DISCIPLINES71: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
