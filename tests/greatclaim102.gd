extends "res://tests/support/game_fixture.gd"
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 check(not HoldGreatClaim102.active(g.state),"Legacy fortune does not silently join claim")
 HoldDisciplines.award(g.state,"mining",1)
 check(not HoldGreatClaim102.active(g.state),"Old work remains unmigrated")
 HoldFirstVisit99.begin(g);settle()
 var d=HoldGreatClaim102.data(g.state)
 check(HoldGreatClaim102.active(g.state) and int(d.points)==0,"New first visit starts ledger with no historical credit")
 HoldDisciplines.award(g.state,"mining",3,"ledger-test")
 HoldDisciplines.award(g.state,"mining",3,"ledger-test")
 check(int(d.points)==3,"Actual work hook respects unique events")
 HoldDisciplines.award(g.state,"mining",50)
 check(int(d.points)==8,"Repeated basic work has bounded contribution credit")
 HoldDisciplines.award(g.state,"woodworking",2)
 check(int(d.points)==10,"Other productive discipline adds its own work credit")
 var initial=g.surface.roads.furnishings("trail").size()
 for id in HoldGreatClaim102.PROJECTS:
  var p=HoldGreatClaim102.PROJECTS[id]
  at(Vector2(670,440));check(g.surface.walkable(g.player) and HoldGreatClaim102.near(g),"Ledger approach is clear")
  for item in p.cost:g.state.inventory[item]=0
  check(not HoldGreatClaim102.contribute(g,id),"Missing resources prevent civic completion")
  for item in p.cost:g.state.add(item,p.cost[item])
  var inventory=g.state.inventory.duplicate(true);at(Vector2(240,550))
  check(not HoldGreatClaim102.contribute(g,id) and inventory==g.state.inventory,"Remote contribution cannot consume pack")
  at(Vector2(670,440));g.surface.action("great_claim102");button("Contribute · "+p.title)
  check(HoldGreatClaim102.complete(g.state,id),"UI makes a real civic contribution")
  for item in p.cost:check(g.state.count(item)==0,"Civic materials actually consumed")
  var points=int(d.points)
  check(not HoldGreatClaim102.contribute(g,id) and int(d.points)==points,"Stale callback cannot repeat project")
  g.close_panel()
 check(g.surface.roads.furnishings("trail").size()==initial+8,"Three projects add eight visible physical furnishings")
 check(int(d.points)==150,"Only verified work and three projects award marks")
 var standings=HoldGreatClaim102.standings(g.state);g.state.elapsed+=100000
 check(standings==HoldGreatClaim102.standings(g.state),"Competitor standings never advance on waiting")
 g.save_game();g.start_game(true);settle()
 check(HoldGreatClaim102.complete(g.state,"watch") and int(HoldGreatClaim102.data(g.state).points)==150,"Project and work credit survive reload")
 at(Vector2(670,440));g.open_panel("great_claim102");await snap("ledger");g.close_panel()
 g.surface.enter("trail");settle();at(Vector2(1400,730));await snap("improved-trail");at(Vector2(920,630));await snap("dry-stores")
 for t in range(0,80,5):
  for actor in g.surface.roads.people("trail",t):check(g.surface.walkable(actor.p),"Civic props preserve road patrol "+actor.name)
 print("GREATCLAIM102: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
