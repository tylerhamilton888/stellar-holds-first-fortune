extends "res://tests/support/game_fixture.gd"
func fits(label:String):
 var rect=g.panel.get_global_rect()
 check(rect.position.x>=0 and rect.position.y>=0 and rect.end.x<=960 and rect.end.y<=540,label+" stays inside the viewport")
func run():
 output=OS.get_cmdline_user_args()[0] if not OS.get_cmdline_user_args().is_empty() else "user://menu92"
 DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 g.state.opening=4;HoldOnboarding.ensure(g.state).fresh=false;HoldOnboarding.ensure(g.state).combat=true
 for id in HoldData.ITEMS:g.state.add(id,12)
 var inventory=g.state.inventory.duplicate(true)
 key(KEY_I);await snap("inventory");fits("Inventory")
 check(g.menu_scroll.get_v_scroll_bar().max_value<=g.menu_scroll.size.y+1,"Full pack and character summary fit without scrolling")
 check(g.panel.find_child("PackGrid",true,false).columns==10,"Inventory presents a ten-column slot grid")
 var item=g.panel.find_child("Item_stone",true,false);item.pressed.emit();button("6")
 check(g.hotbar.data().slots[5]=="stone" and g.state.inventory==inventory,"Pinning uses existing hotbar without transferring or duplicating goods")
 var search=g.panel.find_child("PackSearch",true,false);search.text="no such item";search.text_changed.emit(search.text)
 check(not item.visible,"Pack search filters visible slots")
 search.text="Stone";search.text_changed.emit(search.text);check(item.visible,"Pack search restores matching items")
 key(KEY_PAGEDOWN);check(g.panel_id=="equipment" and g.menu_history.is_empty(),"Page Down switches peer tabs without back-stack growth")
 key(KEY_PAGEUP);check(g.panel_id=="inventory","Page Up returns to inventory")
 button("Skills");await snap("skills");fits("Skills")
 check(g.menu_scroll.get_v_scroll_bar().max_value<=g.menu_scroll.size.y+1,"All thirteen skills fit in the overview")
 button("Farming");check(g.skill_detail and g.discipline_tab=="farming","Selecting a skill opens its own techniques")
 HoldDisciplines.award(g.state,"farming",16);g.refresh_panel();button("Learn technique")
 check(HoldDisciplines.has(g.state,"gentle_tending"),"Technique button uses existing progression transaction")
 await snap("skill-detail");button("‹ All skills");check(not g.skill_detail,"Skills return control restores overview")
 g.surface.enter("room:commission");settle();g.player=Vector2(620,465)
 HoldConversation.start(g,"ivar");check(g.panel_id=="conversation","Local conversation still opens")
 await snap("conversation");fits("Conversation")
 check(g.panel.position.y>150 and g.panel.find_child("BookTabs",true,false)==null,"Dialogue sits below world view without unrelated player tabs")
 button("How have you been?");await snap("friendship")
 check(g.talk_topic=="person","Personal dialogue action still reaches relationship screen")
 g.open_panel("roster");await snap("people");fits("People")
 for id in ["commission","calendar","settings","equipment","help","pause","recipes"]:
  g.open_panel(id,false);await snap(id);fits(id)
  check(g.panel.find_child("BookTabs",true,false)!=null,id+" retains shared navigation")
 g.menu_history.clear();key(KEY_ESCAPE);check(not g.panel.visible,"Escape closes the book")
 g.save_game();g.start_game(true);settle()
 check(g.state.inventory==inventory,"New menus preserve inventory through save and reload")
 check(g.hotbar.data().slots[5]=="stone" and HoldDisciplines.has(g.state,"gentle_tending"),"Hotbar and learned skill survive save and reload")
 print("MENU92: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
