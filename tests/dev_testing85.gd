extends "res://tests/support/game_fixture.gd"
func normal_bytes()->Array:
 var result=[]
 for slot in range(1,4):result.append(FileAccess.get_file_as_string(HoldState.slot_path(slot)))
 return result
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 for slot in range(1,4):
  g.state.save_slot=slot;g.state.money=111*slot;g.save_game()
 var protected=normal_bytes();g.show_title()
 check(g.title_ui.find_children("*","Button",true,false).any(func(b):return b.text=="Dev Testing"),"Title exposes developer testing without loading a fortune")
 await snap("00-title")
 g.open_panel("dev_testing");await snap("01-dev-menu")
 check(g.panel.get_global_rect().end.y<=540,"Preset chooser stays within viewport")
 button("Start Combat arena");settle()
 check(g.dev.active() and g.state.save_path()==HoldDevTesting.SAVE and g.state.save_slot==3,"Fresh combat uses separate test save and leaves selected normal slot intact")
 check(normal_bytes()==protected,"Starting a test does not overwrite any normal fortune")
 key(KEY_F9);check(g.panel_id=="dev_testing" and g.menu_paused,"F9 opens paused test controls");key(KEY_F9);check(g.panel_id=="","F9 closes test controls")
 check(g.zone=="mine" and g.combat.armed and g.fight.enemies.size()==1 and g.fight.enemies[0].kind==0,"Combat preset immediately supplies an armed player and goblin")
 check(g.state.combat.owned.size()==6 and g.state.count("ammo")>=200,"All weapons, armor and ammunition are supplied")
 for kind in [1,2,3]:
  g.open_panel("dev_testing");button("Fight "+HoldEnemyRoster.spec(kind).name);settle()
  check(g.fight.enemies.size()==1 and g.fight.enemies[0].kind==kind,"Encounter button spawns selected species "+str(kind))
 g.open_panel("dev_testing");button("Fight goblin + orc");settle()
 check(g.fight.enemies.size()==2,"Mixed encounter is immediately available")
 g.open_panel("dev_testing");button("Hitboxes:");check(g.fight.show_hitboxes,"Hitbox inspection toggles through the test menu")
 var timer=g.fight.enemies[0].time;g._process(.5)
 check(g.fight.enemies[0].time==timer,"Test controls pause live combat")
 await snap("02-combat-controls");check(g.panel.get_global_rect().end.y<=540,"Refreshed active controls stay within viewport")
 g.close_panel();await snap("03-arena")
 var enemy=g.fight.enemies[0];enemy.p=g.player+Vector2(60,0);enemy.dir=Vector2.LEFT;g.fight.guard=false;g.fight.hurt_wait=0;g.fight.receive(enemy)
 check(g.state.combat.health<100,"Dev arena retains real incoming damage")
 g.open_panel("dev_testing");button("Heal & restock");check(g.state.combat.health==100,"Restock restores health without replacing scenario")
 g.state.money=777;g.save_game()
 var probe=HoldState.new();probe.save_slot=1
 var file=FileAccess.open(HoldState.slot_path(1),FileAccess.WRITE);file.store_string(FileAccess.get_file_as_string(HoldDevTesting.SAVE));file.close()
 check(probe.load_world(Geology.new()).is_empty() and not HoldState.slot_summary(1).valid,"Normal loader and slot picker reject test-marked files")
 file=FileAccess.open(HoldState.slot_path(1),FileAccess.WRITE);file.store_string(protected[0]);file.close()
 g.show_title();check(not g.state.test_session and not g.dev.badge.visible,"Returning to title disables test routing and badge")
 g.open_panel("dev_testing");button("Resume last test");settle()
 check(g.dev.mode()=="combat" and g.fight.enemies.size()==2 and g.state.money==777,"Saved combat resumes chosen encounter and test inventory")
 g.open_panel("dev_testing");button("Choose another preset");button("Start Construction");settle()
 check(g.surface.area=="claim" and g.state.claim_id=="old_delving","Building preset owns the claim immediately")
 var cell=Vector2i(23,11);var h=g.surface.house
 check(h.build(h.center(cell),"stone_floor"),"Supplied plans and materials build a real foundation")
 check(h.build(h.center(cell),"stairs"),"Foundation supports real connected stairs")
 g.player=Vector2(940,650);g.surface.start_placement("tea_table")
 check(g.surface.place(Vector2(940,600)),"Real furniture placement works in the test claim")
 check(not g.surface.walkable(Vector2(940,585)),"Test furniture retains normal collision")
 await snap("04-building")
 var decor=g.state.surface.decor.duplicate(true);g.save_game();g.dev.resume();settle()
 check(g.state.surface.decor==JSON.parse_string(JSON.stringify(decor)),"Test construction survives save and reload")
 g.open_panel("dev_testing");button("Reset this preset");settle()
 check(g.state.surface.decor.is_empty(),"Reset clears only the test construction")
 g.dev.start("work");settle()
 var facilities=g.handworks.data().facilities.filter(func(f):return g.handworks.local(f) and Vector2(f.x,f.y).distance_to(g.player)<400)
 check(facilities.size()==5,"Mining test supplies five usable benches, racks and cart")
 check(g.handworks.data().loose.size()==2 and not g.combat.armed,"Loose mineral and timber loads are ready with tools drawn")
 var rack=facilities.filter(func(f):return f.kind=="stone_pile")[0]
 var raw=g.handworks.data().loose[0];g.handworks.data().loose.erase(raw);g.handworks.data().carry.append(raw)
 check(g.handworks.deposit(rack)==1,"Test mineral load transfers into real stockpile")
 check(g.deep.world.at(Vector2i(18,14))==3,"Exposed wall includes mineable iron")
 await snap("05-workstations")
 g.dev.start("hearth");settle();var beds=g.fieldwork.data().beds
 check(beds.size()==4 and not beds[0].get("prepared",false) and beds[1].prepared and beds[2].planted and g.fieldwork.ripe(beds[3]),"Garden supplies four different hands-on growth stages")
 g.open_panel("dev_testing");button("Ripen planted beds")
 check(g.fieldwork.ripe(beds[2]) and not beds[0].planted,"Ripen affects only planted beds")
 await snap("06-gardens")
 g.open_panel("dev_testing");button("Go to riverbank");settle();check(g.fieldwork.near_water(),"River shortcut arrives at actual fishing water")
 g.open_panel("dev_testing");button("Go to home kitchen");settle();check(g.hearth.cook("root_hotpot"),"Kitchen shortcut can immediately cook a real meal")
 g.save_game();check(normal_bytes()==protected,"Switching, playing, resetting and saving every preset preserves all normal save bytes")
 g.show_title();g.state.save_slot=2;g.start_game(true);settle()
 check(not g.state.test_session and g.state.money==222 and not g.dev.active(),"Normal fortune loads unchanged after developer session")
 key(KEY_F9);check(g.panel_id=="","Normal play does not expose testing hotkeys")
 g.dev.start("combat");check(not g.dev.active() and g.state.money==222,"Test launcher refuses to replace an active normal session")
 var test_file=FileAccess.get_file_as_string(HoldDevTesting.SAVE)
 g.show_title();g.state.save_slot=1;g.start_game(false);settle()
 check(not g.state.test_session and FileAccess.get_file_as_string(HoldDevTesting.SAVE)==test_file,"Starting a normal new fortune exits test routing and preserves test file")
 print("DEV_TESTING85: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
