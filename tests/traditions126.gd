extends "res://tests/support/game_fixture.gd"
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 var s=g.state;var calendar=HoldCalendar.data(s)
 var names=["Stoneday","Hammerday","Roadday","Shieldday","Oathday","Hearthday","Cupday","Namesday"]
 for day in range(224):check(HoldCalendar.weekday_name(day)==names[day%8],"Continuous eight-day week at day "+str(day))
 check(HoldCalendar.weekday_name(27)=="Shieldday" and HoldCalendar.weekday_name(28)=="Oathday","Season rollover preserves weekday continuity")
 calendar.day=111;calendar.minute=1380;HoldCalendar.advance(s,60)
 check(calendar.day==112 and calendar.minute==0 and HoldCalendar.weekday_name(112)=="Stoneday","Midnight and year rollover preserve the week")
 calendar.day=34;calendar.minute=731;calendar.events={"1:first_hearth":{"id":"first_hearth","year":1,"joined":true}}
 var original_calendar=calendar.duplicate(true)
 g.surface.enter("room:lodge");settle();at(HoldTraditions126.ACCESS)
 check(HoldTraditions126.at_memorial(g) and g.surface.nearest().action=="traditions126","Legacy lodge has reachable memorial")
 check(calendar==original_calendar,"Introducing traditions preserves elapsed dates, clock and feast claims")
 key(KEY_E);check(g.panel_id=="traditions126" and g.menu_paused,"E opens optional paused memorial interaction")
 await snap("01-memorial-offer")
 check(not HoldTraditions126.repair(g),"Memorial is not completed without accepting")
 button("Offer to restore");check(HoldTraditions126.data(s).accepted,"Player can opt into the memorial errand")
 g.open_panel("commission");button("Read the memorial errand")
 check(g.panel_id=="traditions126","Only an accepted errand is available from the quest journal")
 s.inventory.dressed_stone=0
 check(not HoldTraditions126.repair(g),"Missing repair materials do not complete the task")
 s.add("dressed_stone",4);var stone=s.count("dressed_stone");var food=s.count("food")
 g.player=Vector2(620,550);check(not HoldTraditions126.repair(g) and s.count("dressed_stone")==stone,"Stale distant completion cannot charge materials")
 at(HoldTraditions126.ACCESS);check(HoldTraditions126.repair(g),"Local repair consumes supplied stone")
 check(s.count("dressed_stone")==stone-2 and s.count("food")==food+2,"One stated payment and practical thank-you")
 check(not HoldTraditions126.repair(g) and s.count("food")==food+2,"Memorial cannot be farmed for repeated rewards")
 g.refresh_panel();await snap("02-restored-record")
 button("Read about the Eight");await snap("03-optional-lore");g.close_panel()
 g.calendar_page=1;g.calendar_selected=28;g.open_panel("calendar")
 var grids=g.panel_body.find_children("*","GridContainer",true,false)
 var grid=grids[0]
 check(grid.columns==8 and grid.get_child(12) is Button and grid.get_child(12).text.begins_with("1"),"Summer starts below Oathday with four leading blanks")
 await snap("04-eight-day-summer")
 check(calendar.day==34 and calendar.minute==731,"Browsing the eight-day calendar never advances time")
 g.close_panel();g.surface.enter("room:home");settle();at(Vector2(550,480))
 for item in HoldFurnishings.ITEMS.ancestral_shrine.cost:s.add(item,20)
 var shrine_at=Vector2(550,455)
 var paid_stone=s.count("dressed_stone");var paid_wood=s.count("wood")
 g.surface.start_placement("ancestral_shrine")
 check(g.surface.furniture_ready(shrine_at,"ancestral_shrine"),"Household shrine fits through ordinary furnishing validation")
 check(g.surface.place(shrine_at),"Shrine placement succeeds")
 check(s.count("dressed_stone")==paid_stone-4 and s.count("wood")==paid_wood-2,"Shrine costs exactly the listed stone and timber")
 check(s.surface.decor.any(func(f):return f.kind=="ancestral_shrine" and f.area=="room:home"),"Household shrine uses real paid placement")
 at(shrine_at+Vector2(0,30));key(KEY_E)
 check(g.panel_id=="hearth126" and g.menu_paused,"Player shrine has a nearby optional family interaction")
 button("Begin a family");check(HoldTraditions126.data(s).remembered,"Family remembrance is recorded")
 check(not HoldTraditions126.remember(g),"Family remembrance does not repeat")
 await snap("05-household-memory");g.close_panel();await snap("06-household-stone")
 check(g.surface.move_nearby_furnishing(),"A player shrine can be selected for movement")
 check(g.surface.place(shrine_at),"Moving a shrine ignores its own old interaction point")
 check(s.count("dressed_stone")==paid_stone-4 and s.count("wood")==paid_wood-2,"Moving does not charge again")
 at(shrine_at+Vector2(0,30));check(g.surface.recover_decor(),"A player shrine can be recovered")
 check(s.count("dressed_stone")==paid_stone and s.count("wood")==paid_wood,"Recovery returns exactly paid shrine materials")
 check(not HoldTraditions126.home_shrine(g) and not HoldTraditions126.remember(g),"Removing a shrine invalidates a stale family interaction")
 g.surface.start_placement("ancestral_shrine");check(g.surface.place(shrine_at),"Recovered shrine can be rebuilt")
 g.save_game();g.start_game(true);settle();s=g.state
 check(HoldTraditions126.data(s).repaired and HoldTraditions126.data(s).remembered,"Both optional outcomes survive reload")
 check(HoldCalendar.data(s).day==34 and HoldCalendar.data(s).minute==731 and HoldCalendar.data(s).events["1:first_hearth"].joined,"Legacy clock and claimed festival survive reload")
 HoldFirstVisit99.begin(g);settle();s=g.state
 check(g.surface.area==HoldFrontier103.lodge(s),"New opener remains at the existing frontier lodge")
 check(s.surface.decor.filter(func(f):return f.area==HoldFrontier103.lodge(s) and f.kind=="ancestral_shrine").size()==1,"New lodge seeds one fixed memorial")
 s.surface.decor=s.surface.decor.filter(func(f):return f.area!=HoldFrontier103.lodge(s) or f.kind!="ancestral_shrine")
 var chest=s.surface.chests.duplicate(true);var decor_count=s.surface.decor.size()
 HoldTraditions126.ensure_lodge(g);HoldTraditions126.ensure_lodge(g)
 check(s.surface.decor.size()==decor_count+1 and s.surface.chests==chest,"Pre-existing frontier lodge gets exactly one memorial without replacing possessions")
 for day in [0,6,7,14,15,27,28,111,112]:
  HoldCalendar.data(s).day=day
  for minute in [1079.9,1080.0,1081.0,1085.0,1090.0,1140.0,1190.0,1195.0,1199.9,1200.0]:
   HoldCalendar.data(s).minute=minute
   var people=HoldWorkerLodge100.people(g)
   check(people.filter(func(c):return c.interaction=="lodge_folk:2").size()==1,"Weekly activity retains one Sigrid")
   var person=people[-1];check(g.surface.walkable(person.p),"Gathering route remains walkable on day %d at %.1f" % [day,minute])
   if day%8 not in [6,7] or minute<1080 or minute>=1200:check(person.p==Vector2(620,480) and person.role=="Miner","Ordinary days retain Sigrid's normal activity")
 HoldCalendar.data(s).day=7;HoldCalendar.data(s).minute=1140;at(Vector2(300,480));await snap("07-namesday-lodge")
 HoldCalendar.data(s).day=6;await snap("08-cupday-lodge")
 var first=HoldTraditions126.sigrid(g,s.elapsed);g.save_game();g.start_game(true);settle()
 check(HoldTraditions126.sigrid(g,g.state.elapsed)==first,"Gatherings retain position and identity on reload")
 g.surface.enter(HoldFrontier103.quarters(g.state));settle();check(not HoldTraditions126.accept(g) and not HoldTraditions126.repair(g),"Memorial callbacks fail outside the lodge")
 g.open_panel("home")
 var shrine_button:Button
 for b in g.panel.find_children("*","Button",true,false):
  if b.text.begins_with("Ancestral hearthstone"):shrine_button=b
 check(shrine_button!=null,"Private-room catalogue exposes the shrine with its own icon")
 if shrine_button!=null:
  await process_frame;g.menu_scroll.ensure_control_visible(shrine_button)
 await snap("09-shrine-catalogue");g.close_panel()
 HoldFrontier103.data(g.state).keldrath_open=true;g.surface.enter("crownward");settle();at(Vector2(970,705))
 check(g.surface.nearest().action=="ward_notice:oaths","Existing Oath Stone has reachable optional inscription")
 key(KEY_E);check(g.notice.contains("Thorek"),"Oath Stone shares a short context-specific custom")
 await snap("10-oath-stone")
 print("TRADITIONS126: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
