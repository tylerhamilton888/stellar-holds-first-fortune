extends "res://tests/support/game_fixture.gd"
func run():
 output=OS.get_cmdline_user_args()[0];DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 g.state.opening=4;HoldOnboarding.ensure(g.state).fresh=false
 check(not HoldExpedition97.accept(g),"Expedition cannot be accepted remotely")
 g.surface.enter("room:commission");settle()
 check(HoldExpedition97.accept(g),"Ivar accepts the first expedition")
 check(not HoldExpedition97.accept(g),"Repeated acceptance cannot reset progress")
 g.state.add("iron_ore",12);g.state.add("coal",8)
 check(not HoldExpedition97.ready(g.state),"Existing inventory cannot instantly finish an expedition")
 g.open_panel("commission");await snap("briefing");g.close_panel()
 g.dev.arena(0);settle();var h=g.handworks
 g.state.add("wood",10);g.state.add("stone",10);g.player=Vector2(820,820)
 check(h.build("breaker",Vector2(820,900)),"Expedition uses ordinary player equipment")
 var q=HoldExpedition97.data(g.state)
 HoldExpedition97.processed(g,{"id":int(q.first_raw)-1,"source":"rock:0:old","kind":"stone","units":12,"item":"iron_ore"})
 check(q.credit.is_empty(),"Previously mined raw stock cannot count")
 for item in ["iron_ore","coal"]:
  h.spawn("stone",g.player,12 if item=="iron_ore" else 8,"rock:0:test",item)
  h.data().carry.append(h.data().loose.pop_back());g.player=Vector2(820,940);h.active_id="";g.combat.armed=false
  Input.action_press("interact")
  for i in 240:h.update(1.0/60)
  Input.action_release("interact")
 check(HoldExpedition97.ready(g.state),"Real stonebreaker completion credits both fresh resources")
 check(not HoldExpedition97.deliver(g),"Return to Ivar is required to receive rewards")
 g.save_game();g.start_game(true);settle()
 check(HoldExpedition97.ready(g.state),"Fresh-work credit survives save and reload")
 g.surface.enter("room:commission");settle();var money=g.state.money;var ore=g.state.count("iron_ore");var wood=g.state.count("wood")
 check(HoldExpedition97.deliver(g),"Completed expedition delivers at Ivar")
 check(g.state.count("iron_ore")==ore-12 and g.state.money==money+80 and g.state.count("wood")==wood+6,"Delivery consumes its supplies and pays the exact reward")
 check(not HoldExpedition97.deliver(g),"Reward cannot be collected twice")
 check(HoldExpedition97.data(g.state).stage==1 and HoldExpedition97.accept(g),"First delivery opens the crystal follow-up")
 g.open_panel("commission");await snap("follow-up")
 g.close_panel();g.save_game();var fortune=FileAccess.get_file_as_string(g.state.save_path())
 g.show_title();g.dev.start("expedition");settle()
 check(g.dev.mode()=="expedition" and HoldConversation.local(g,"ivar"),"Separate expedition preset starts at Ivar")
 check(g.state.count("iron_ore")==0 and g.state.money==45 and g.state.tech.is_empty(),"Playtest starts with ordinary progression rather than unlimited supplies")
 check(FileAccess.get_file_as_string(HoldState.SAVE)==fortune,"Expedition test preserves the normal fortune")
 print("EXPEDITION97: ",passed," passed / ",failed," failed")
 g.sound.stop_all();g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
