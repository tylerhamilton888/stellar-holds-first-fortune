extends "res://tests/input_surface49.gd"
func run():
 output="res://docs/testing/animation-0.51.0/labor";DirAccess.make_dir_recursive_absolute(output)
 g=load("res://main.tscn").instantiate();root.add_child(g);g.set_process(false);g.skip_arrival=true;g.start_game(false);settle()
 g.state.opening=4;HoldOnboarding.ensure(g.state).fresh=false;g.state.claim_id="old_delving";g.surface.enter("claim");settle()
 for k in ["wood","stone","iron","water"]:g.state.add(k,50)
 var life=g.fieldwork;var wood=g.state.count("wood")
 check(life.craft_kit() and g.state.count("wood")==wood-3 and g.state.count("turnip_seed")==4,"Field tools charge once and supply four seed")
 check(not life.craft_kit() and g.state.count("turnip_seed")==4,"Field tools cannot duplicate starter seed")
 at(Vector2(790,590));check(life.build(Vector2(830,550)),"Garden bed crafts on clear claim ground")
 var b=life.data().beds[0];check(not life.build(Vector2(830,550)),"Garden beds refuse overlap")
 at(Vector2(830,605));key(KEY_E);await frames(90)
 check(b.planted and g.state.count("turnip_seed")==3,"E approaches and plants one seed at animation contact")
 await snap("01-planted")
 var water=g.state.count("water");key(KEY_E);await frames(80)
 check(b.watered and g.state.count("water")==water-1,"Watering uses exactly one pack water")
 await snap("02-watered")
 g.save_game();g.start_game(true);settle();life=g.fieldwork;b=life.data().beds[0]
 check(b.planted and b.watered and life.data().kit,"Crop, water and field tools survive real reload")
 g.state.tick(181);at(life.pos(b)+Vector2(-65,-18));await snap("03-ripe")
 check(life.ripe(b),"Watered crop grows while time passes elsewhere")
 key(KEY_E);await frames(60)
 check(g.state.count("turnip")==2 and g.state.count("turnip_seed")==4 and not b.planted,"Harvest returns produce and renewable seed exactly once")
 var harvested=g.state.count("turnip");await frames(60);check(g.state.count("turnip")==harvested,"Finished animation cannot duplicate harvest")
 g.surface.enter("trail");settle();at(HoldHomesteadLife.BANK)
 check(g.surface.walkable(g.player) and not g.surface.walkable(Vector2(1220,550)),"Fishing bank is walkable and visible river remains solid")
 key(KEY_E);await frames(40);await snap("04-casting")
 await frames(200);await snap("05-bite")
 check(life.action=="fish" and g.state.count("river_fish")==0,"Fish waits for reel with no missed-bite penalty")
 Input.action_press("interact");await frames(60);Input.action_release("interact")
 check(g.state.count("river_fish")==1 and life.action=="","Holding E reels one real fish into pack")
 check(life.data().facts.get("reward",false),"First harvest and catch complete the practical lesson once")
 var food=g.state.count("food");check(g.state.craft("trout_supper"),"Existing production queue accepts catch recipe")
 g.state.tick(4);check(g.state.count("food")==food+3 and g.state.count("river_fish")==0,"Catch becomes provisions through existing production")
 key(KEY_E);Input.action_press("left");await frames(5);Input.action_release("left")
 check(life.action=="" and g.state.count("river_fish")==0,"Walking cancels a cast without creating rewards")
 g.surface.enter("room:market");settle();var money=g.state.money
 check(g.state.trade("turnip",false) and g.state.money>money,"Existing market sells harvested produce")
 g.surface.enter("claim");settle();at(Vector2(1040,790));var h=g.handworks
 check(not h.build("wagon",Vector2(1060,830)),"Freight wagon requires earned handling mastery")
 h.data().skills.mason=8
 check(h.build("wagon",Vector2(1060,830)),"Mastery unlocks craftable 24-load freight wagon")
 h.spawn("stone",g.player,1);key(KEY_E);await frames(30);h.spawn("log",g.player,2);key(KEY_E);await frames(30)
 check(h.data().carry.size()==2 and h.carry_action()=="double_mixed","Strong Shoulders supports one rock and one log with a mixed pose")
 await snap("06-two-shoulders")
 at(Vector2(1060,875));key(KEY_E)
 var wagon=h.data().facilities[0]
 check(wagon.raw.size()==2 and h.data().carry.is_empty(),"Wagon receives both physical loads without duplication")
 key(KEY_C);Input.action_press("right");await frames(20);Input.action_release("right");await snap("07-wagon")
 check(wagon.hitched and h.pos(wagon).distance_to(g.player)<40,"Hitched freight wagon follows clear player route")
 key(KEY_C);g.save_game();g.start_game(true);settle()
 check(g.handworks.data().facilities[0].raw.size()==2 and g.fieldwork.data().facts.get("reward",false),"Wagon cargo, mastery and lesson rewards persist")
 g.open_panel("fieldwork");await snap("08-fieldwork-menu");g.close_panel()
 g.surface.enter("trail");settle();at(Vector2(950,340));key(KEY_E);settle()
 check(g.zone=="mine","Existing trail door enters integrated mine")
 await snap("09-continuous-mine")
 print("LABOR51: ",passed," passed / ",failed," failed");g.playing=false;g.queue_free();await process_frame;quit(1 if failed else 0)
